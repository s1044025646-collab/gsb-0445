{
  "name": "kanon-generalizer",
  "version": "1.0.0",
  "description": "本地有限层级 k 匿名泛化与等价组核验后端（TypeScript + Node.js + SQLite）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "kanon": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "dev": "node --experimental-strip-types src/server/index.ts",
    "demo": "node dist/cli/index.js demo",
    "test": "tsc -p tsconfig.json && node --test test/*.test.ts",
    "cli": "node --experimental-strip-types src/cli/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
